mvn test -Dgroups=api -Dregion=IT

pipeline {
    agent {
        docker {
            image 'mcr.microsoft.com/playwright/java:latest'
        }
    }

    stages {

        stage('Cleanup') {
            steps {
        sh 'rm -rf target || true'
            }
        }

        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/SkiPPerUA/DeviArtQA.git'
            }
        }

        stage('Build & Test') {
            steps {
                sh 'mvn test -Dgroups=${group} -Dregion=${region}'
            }
        }
    }

    post {
        always {
            junit 'target/surefire-reports/*.xml'
        }
    }

}